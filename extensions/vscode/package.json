{
  "name": "hacktrail",
  "displayName": "HackTrail",
  "description": "Local editor tracking with offline sync, project statistics, and optional Git and agent activity.",
  "version": "0.5.0",
  "publisher": "swamstick911",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Swamstick911/HackTrail.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "hacktrail.connect",
        "title": "HackTrail: Enable Tracking"
      },
      {
        "command": "hacktrail.toggleTracking",
        "title": "HackTrail: Pause or Resume Tracking"
      },
      {
        "command": "hacktrail.openDashboard",
        "title": "HackTrail: Open Dashboard"
      },
      {
        "command": "hacktrail.disableClaude",
        "title": "HackTrail: Disable Claude Tracking"
      },
      {
        "command": "hacktrail.disableCodex",
        "title": "HackTrail: Disable Codex Tracking"
      },
      {
        "command": "hacktrail.disableGit",
        "title": "HackTrail: Disable Git Collection"
      },
      {
        "command": "hacktrail.connectAccount",
        "title": "HackTrail: Connect Account"
      },
      {
        "command": "hacktrail.disconnectAccount",
        "title": "HackTrail: Disconnect Account"
      },
      {
        "command": "hacktrail.openPlatform",
        "title": "HackTrail: Open Platform"
      }
    ]
  }
}
