{
  "name": "hacktrail",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build && vite build --config vite.platform.config.ts && node scripts/build-adapters.mjs && node scripts/package-extension.mjs",
    "package:extension": "vite build && node scripts/build-adapters.mjs && node scripts/package-extension.mjs",
    "connect:codex": "node dist/cli/connect-codex.js",
    "connect:claude": "node dist/cli/connect-claude.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "start:platform": "node dist/platform/main.js",
    "dev:platform": "tsx watch src/platform/main.ts",
    "test:e2e:platform": "playwright test --config playwright.platform.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "better-auth": "1.7.27",
    "fastify": "5.12.8",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
