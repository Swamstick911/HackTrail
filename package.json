{
  "name": "hacktrail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/build-adapters.mjs && node scripts/package-extension.mjs",
    "package:extension": "node scripts/build-adapters.mjs && node scripts/package-extension.mjs",
    "connect:claude": "node dist/cli/connect-claude.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
