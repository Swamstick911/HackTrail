NODE_ENV=development
HACKTRAIL_ORIGIN=http://127.0.0.1:47657
HACKTRAIL_PLATFORM_HOST=127.0.0.1
HACKTRAIL_PLATFORM_PORT=47657
HACKTRAIL_PLATFORM_DATA_DIR=.hacktrail-platform
HACKTRAIL_REGISTRATION_OPEN=true
# Production requires HTTPS, a generated secret, and both mail settings.
# HACKTRAIL_AUTH_SECRET=
# HACKTRAIL_SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# HACKTRAIL_MAIL_FROM=HackTrail <noreply@example.com>
# HACKTRAIL_TRUST_PROXY=127.0.0.1,::1
